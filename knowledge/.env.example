# ============================================================
# 掌柜智库 (zhiku-shopkeeper) 环境变量配置模板
# ------------------------------------------------------------
# 使用方法：
#   cp .env.example .env      # Linux / macOS
#   copy .env.example .env    # Windows CMD
#   然后在 .env 中填入你自己的真实密钥。
#
# 注意：.env 已被 .gitignore 忽略，请勿提交到任何代码仓库。
# ============================================================

# ==================== 模型来源与缓存 ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1 开启，离线部署时使用）
# MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=/path/to/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=/path/to/huggingface_cache

# ===================== MinerU 文档解析服务 =====================
# MinerU 开放平台 API Token（在 https://mineru.net 申请）
MINERU_API_TOKEN=your_mineru_api_token_here
# MinerU 接口基础地址
MINERU_BASE_URL=https://mineru.net/api/v4
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ==================== LLM / VLM（OpenAI 兼容协议） ====================
# API 密钥（兼容 OpenAI 格式的任意服务商，如智谱 / DashScope）
OPEN_API_KEY=your_llm_api_key_here
# API 基础地址
OPEN_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 默认 LLM 模型
LLM_DEFAULT_MODEL=glm-4.5-flash
# 默认温度参数
LLM_DEFAULT_TEMPERATURE=0.1
# VLM 视觉语言模型（用于图片摘要）
VL_MODEL=GLM-4.6V-Flash
# 商品名识别专用模型
ITEM_MODEL=glm-4.5-flash

# ==================== BGE 向量模型 ====================
# BGE-M3 稠密+稀疏嵌入模型本地路径
BGE_M3_PATH=/path/to/bge-large-zh-v1.5
# BGE-M3 模型名称（HuggingFace / ModelScope 上的 id）
BGE_M3=BAAI/bge-large-zh-v1.5
# 嵌入模型运行设备（cpu / cuda）
BGE_DEVICE=cpu
# 是否使用半精度
BGE_FP16=False
# BGE Reranker 重排序模型本地路径
BGE_RERANKER_LARGE=/path/to/bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cpu
# 重排序模型半精度
BGE_RERANKER_FP16=1
# 商品名诊断日志开关
ITEM_NAME_DIAG=1

# ==================== Embedding 通用配置 ====================
# 嵌入向量维度（bge-large-zh-v1.5 为 1024）
EMBEDDING_DIM=1024
# 嵌入模型名称
EMBEDDING_MODEL=embedding-3

# ==================== 向量数据库 Milvus ====================
# Milvus 连接地址
MILVUS_URL=http://127.0.0.1:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks_v1
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names_v1
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ==================== 文档数据库 MongoDB ====================
# MongoDB 连接 URL（请替换为你的账号密码）
MONGO_URL=mongodb://user:password@127.0.0.1:27017
# 数据库名
MONGO_DB_NAME=kb001

# ==================== 对象存储 MinIO ====================
# MinIO 服务端点（host:port）
MINIO_ENDPOINT=127.0.0.1:9000
# 访问密钥
MINIO_ACCESS_KEY=your_minio_access_key
# 私有密钥
MINIO_SECRET_KEY=your_minio_secret_key
# 存储桶名称
MINIO_BUCKET_NAME=knowledge-base-v1

# ==================== MCP 网络搜索服务 ====================
# 百炼 WebSearch MCP 服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# 百炼 API Key
MCP_DASHSCOPE_API_KEY=your_dashscope_api_key_here
